{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "lenis": "^1.3.21",
    "octokit": "^5.0.5",
    "react": "^19.2.4",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-rough-notation": "^1.0.8",
    "react-router-dom": "^7.13.2",
    "tinycolor2": "^1.6.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "serve": "^14.2.6",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "webpack-bundle-analyzer": "^5.3.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --passWithNoTests",
    "analyze": "pnpm run build && pnpm dlx serve -s dist",
    "analyze:bundle": "pnpm run build && pnpm dlx webpack-bundle-analyzer dist/assets/*.js",
    "build:analyze": "pnpm run build && echo 'Build completed! Run pnpm run analyze:bundle to analyze bundle size'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
